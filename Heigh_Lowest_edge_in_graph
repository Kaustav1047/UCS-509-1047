
#include <stdio.h>

int main() {
    int n, i, j;
    int a[10][10];
    int min, max;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    min = 9999;
    max = -1;

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {

            if (a[i][j] != 0 && a[i][j] < min) {
                min = a[i][j];
            }

            if (a[i][j] != 0 && a[i][j] > max) {
                max = a[i][j];
            }
        }
    }

    if (max == -1) {
        printf("No edges found\n");
    } else {
        printf("Lowest edge weight = %d\n", min);
        printf("Highest edge weight = %d\n", max);
    }

    return 0;
}

