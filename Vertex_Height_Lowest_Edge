
#include <stdio.h>

int main() {
    int n, i, j;
    int a[10][10];
    int degree[10];
    int min, max;
    int minVertex, maxVertex;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (i = 0; i < n; i++) {
        degree[i] = 0;

        for (j = 0; j < n; j++) {
            degree[i] += a[i][j];
        }
    }

    min = max = degree[0];
    minVertex = maxVertex = 0;

    for (i = 1; i < n; i++) {
        if (degree[i] < min) {
            min = degree[i];
            minVertex = i;
        }

        if (degree[i] > max) {
            max = degree[i];
            maxVertex = i;
        }
    }

    printf("\nVertex with lowest degree: V%d", minVertex + 1);
    printf("\nLowest degree: %d", min);

    printf("\nVertex with highest degree: V%d", maxVertex + 1);
    printf("\nHighest degree: %d\n", max);

    return 0;
}
